rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Spark 免費方案：以 coaches/{uid} 判定會員（無需 Custom Claims／Cloud Functions）
    function isCoach() {
      return request.auth != null
        && exists(/databases/$(database)/documents/coaches/$(request.auth.uid))
        && get(/databases/$(database)/documents/coaches/$(request.auth.uid)).data.active == true;
    }

    // 教練檔案：本人可讀；僅 Admin SDK／Console 可寫
    match /coaches/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 舊版電話名單（Blaze＋Functions 用）；客戶端一律不可讀寫
    match /allowlist/{phoneId} {
      allow read, write: if false;
    }

    match /members/{uid} {
      allow read: if isCoach() && request.auth.uid == uid;
      allow write: if false;
    }

    match /coachContent/{slug} {
      allow read: if isCoach();
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if isCoach();
      allow create: if isCoach()
        && request.resource.data.keys().hasAll(['authorUid', 'authorName', 'body', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 4000;
      allow update, delete: if isCoach()
        && resource.data.authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isCoach();
        allow create: if isCoach()
          && request.resource.data.keys().hasAll(['authorUid', 'authorName', 'body', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000;
        allow delete: if isCoach()
          && resource.data.authorUid == request.auth.uid;
        allow update: if false;
      }
    }

    match /joinRequests/{id} {
      allow read, write: if false;
    }
  }
}
