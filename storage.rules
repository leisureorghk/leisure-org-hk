rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isCoach() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/coaches/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/coaches/$(request.auth.uid)).data.active == true;
    }

    function isImageOrVideo() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('video/.*');
    }

    function sizeOk() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    match /media/{uid}/{allPaths=**} {
      allow read: if isCoach();
      allow create: if isCoach()
        && request.auth.uid == uid
        && isImageOrVideo()
        && sizeOk();
      allow update: if false;
      allow delete: if isCoach() && request.auth.uid == uid;
    }

    match /coach-materials/{allPaths=**} {
      allow read: if isCoach();
      allow write: if false;
    }
  }
}
